{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "DAB Live Account",
            "items": [
                {
                    "type": "Label",
                    "caption": "Use a DAB Live account with email + password (NOT Google login). Tip: create a separate account and share the installation with it."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Username",
                    "caption": "Email"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "Password",
                    "caption": "Password"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Device Selection (optional)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Leave empty to automatically use the first installation and device. Use 'Test Connection' to list available IDs."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "InstallationID",
                    "caption": "Installation ID"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Serial",
                    "caption": "Device Serial"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Options",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "UpdateInterval",
                    "caption": "Update Interval",
                    "suffix": "seconds",
                    "minimum": 0,
                    "maximum": 3600
                },
                {
                    "type": "CheckBox",
                    "name": "CreateAdvanced",
                    "caption": "Create advanced variables (config, counters, errors)"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Test Connection",
            "onClick": "DABEsy_TestConnection($id);"
        },
        {
            "type": "Button",
            "caption": "Update Now",
            "onClick": "DABEsy_Update($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Active"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Inactive - please enter email and password"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Login failed - check credentials"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "No device found in account"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Failed to fetch device status"
        }
    ]
}
